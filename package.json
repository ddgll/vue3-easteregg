{
  "name": "vue3-easteregg",
  "version": "1.0.2",
  "description": "A Vue3 Component to easely add an easteregg to your website or webapp =)",
  "author": "David Grill <grilldotcom@gmail.com>",
  "main": "dist/Vue3Easteregg.ssr.js",
  "browser": "dist/Vue3Easteregg.esm.js",
  "module": "dist/Vue3Easteregg.esm.js",
  "unpkg": "dist/Vue3Easteregg.min.js",
  "files": [
    "dist/*",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/Vue3Easteregg.esm.js",
      "require": "./dist/Vue3Easteregg.ssr.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue": "^3.5.22"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "engines": {
    "node": ">=12"
  }
}
