{
  "name": "vue3-easteregg",
  "version": "1.0.2",
  "description": "A Vue3 Component to easely add an easteregg to your website or webapp =)",
  "author": "David Grill <grilldotcom@gmail.com>",
  "main": "dist/Vue3Easteregg.ssr.js",
  "browser": "dist/Vue3Easteregg.esm.js",
  "module": "dist/Vue3Easteregg.esm.js",
  "unpkg": "dist/Vue3Easteregg.min.js",
  "files": [
    "dist/*",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "scripts": {
    "serve": "vue-cli-service serve dev/serve.js",
    "prebuild": "rimraf ./dist",
    "build": "cross-env NODE_ENV=production rollup --config build/rollup.config.js",
    "build:ssr": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format cjs",
    "build:es": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format es",
    "build:unpkg": "cross-env NODE_ENV=production rollup --config build/rollup.config.js --format iife"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/compiler-sfc": "^3.5.22",
    "cross-env": "^10.1.0",
    "minimist": "^1.2.8",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.4",
    "rollup-plugin-postcss": "^4.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup-plugin-vue": "^6.0.0",
    "vue": "^3.5.22"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "engines": {
    "node": ">=12"
  }
}
